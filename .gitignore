# =============================================================
#  CAGE EMPIRE - .gitignore
# =============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
env/
ENV/

# ---- IDE / Editor ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Project: database ----
# The world DB (cage_empire.db) SHIPS WITH THE GAME — it's the default
# game data, like FM/W MMA5. Do NOT ignore it.
# But DO ignore save games, backups, test DBs, and temp files.
data/cage_empire_test.db
data/cage_empire.db.backup-*
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/saves/
data/backups/

# ---- Project: but DO keep data/.gitkeep so the folder exists ----
!data/.gitkeep

# ---- Logs / runtime ----
logs/
*.log

# ---- Mod / user content (keep folders, ignore user data) ----
mods/user/*
!mods/user/.gitkeep
saves/*
!saves/.gitkeep

# ---- Build / dist ----
build/
dist/
*.spec

# ---- Secrets ----
.env
.env.local
*.secret
secrets/
